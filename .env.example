OPENAI_API_KEY=sk-your-key-here
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=shimmer
ORGANIZER_NAME=Sara
COMPANY_NAME=Karyan
JWT_SECRET=change-this-to-a-long-random-string
FRONTEND_URL=http://127.0.0.1:3000
API_PUBLIC_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Optional OAuth (Google can auto-load from credentials.json)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Phone agent: agent + voice live in ElevenLabs dashboard ---
# Public HTTPS URL — use a fixed deploy URL in production (see docs/DEPLOY.md)
# Local dev only: temporary tunnel URL
# API_PUBLIC_URL=https://your-app.onrender.com

# Bearer token — add as Authorization header on every ElevenLabs server tool
TELEPHONY_WEBHOOK_SECRET=change-me-telephony-secret

# Optional — Twilio reference / status logging only (import number in ElevenLabs UI)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Optional — cloud deploy: one-line JSON from scripts/pack_google_token.py
# GOOGLE_TOKEN_JSON=

# Optional — GET /api/telephony/voices helper only
ELEVENLABS_API_KEY=
